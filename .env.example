# Copy this file to .env and fill in your own values. Never commit .env.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# "gemma" uses Gemma 4 through the Gemini API; "mock" never calls a model.
PRTM_AI_PROVIDER=gemma

# Gemma 4 models listed for the Gemini API: gemma-4-26b-a4b-it or gemma-4-31b-it
PRTM_GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional tuning
PRTM_REQUEST_TIMEOUT=120
PRTM_MAX_DEPTH=4
PRTM_MAX_NODES=200
PRTM_CONTEXT_BUDGET=30000
